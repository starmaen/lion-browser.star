{
  "manifest_version": 3,
  "name": "Lion Browser",
  "version": "1.0",
  "description": "متصفح Lion Browser",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "downloads",
    "bookmarks",
    "history",
    "search",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
